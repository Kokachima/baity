# ========================================================
# BAITY FASHION E-COMMERCE - DANH SÁCH BIẾN MÔI TRƯỜNG
# ========================================================
# LƯU Ý: File này là mẫu cấu hình, TUYỆT ĐỐI KHÔNG chứa khóa bí mật thật.

# --------------------------------------------------------
# I. CẤU HÌNH CỐT LÕI & BẢO MẬT (BẮT BUỘC Ở PRODUCTION)
# --------------------------------------------------------

# [BẮT BUỘC Ở PRODUCTION] Môi trường vận hành ('development' | 'production')
NODE_ENV="development"

# [CHỈ DÀNH CHO AI STUDIO PREVIEW] Đặt "preview" trên AI Studio để cho phép chạy NODE_ENV="production" không nghiêm ngặt.
# Ở Production thật (Render), để trống; RENDER="true" và PRODUCTION_STRICT="true" luôn thắng APP_MODE="preview".
APP_MODE=""

# [TÙY CHỌN] Cổng chạy ứng dụng (Mặc định: 3000; trên Render do nền tảng tự cấp)
PORT=3000

# [TỰ ĐỘNG TRÊN RENDER / TÙY CHỌN] Cờ kích hoạt kiểm tra bảo mật nghiêm ngặt ở Production
RENDER="false"
PRODUCTION_STRICT="false"

# [CẤM Ở PRODUCTION] Chế độ CSDL nhúng PGlite và nạp tài khoản mẫu chỉ dùng khi phát triển cục bộ
USE_PGLITE="false"
SEED_DEV_ACCOUNTS="false"

# [BẮT BUỘC Ở PRODUCTION] Chuỗi kết nối PostgreSQL bền vững (Supabase Session Pooler cổng 5432 hoặc Transaction Pooler cổng 6543)
# Ví dụ: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baity"

# [BẮT BUỘC Ở PRODUCTION] Khóa bí mật ký JWT cho cookie xác thực httpOnly (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET="replace-with-strong-random-32-bytes-jwt-secret-key"

# [BẮT BUỘC Ở PRODUCTION KHI CSDL TRỐNG] Email và mật khẩu khởi tạo quản trị viên đầu tiên (khác tài khoản dev, tối thiểu 12 ký tự, có chữ và số, không thuộc danh sách cấm)
ADMIN_EMAIL="quanly@baity.vn"
ADMIN_INITIAL_PASSWORD=

# [BẮT BUỘC Ở PRODUCTION] URL gốc chính thức của ứng dụng (https://...) dùng tạo link email và đối chiếu Origin
APP_URL="http://localhost:3000"

# [CẤM BẬT Ở PRODUCTION] Đặt "false" trên Render. Chỉ bật "true" trong môi trường Preview iframe khác tên miền
COOKIE_CROSS_SITE="false"

# [BẮT BUỘC Ở PRODUCTION] Danh sách Origin được phép gửi request thay đổi dữ liệu (phân cách bởi dấu phẩy, cấm '*')
ALLOWED_ORIGINS="http://localhost:3000"

# [TÙY CHỌN] Số lớp reverse proxy tin cậy cho Express trust proxy (Render: 1; AI Studio Preview: 2)
TRUST_PROXY_HOPS=1

# [CHỈ DÙNG Ở BẢN CHẠY THỬ] Ở Production luôn để trống (CSP tự động khóa cứng frame-ancestors 'self')
FRAME_ANCESTORS=""

# [TÙY CHỌN] Danh sách tên miền ảnh bổ sung cho CSP img-src ở Production (ngăn cách bằng dấu phẩy, không có https://; đặt dạng chú thích để AI Studio không bắt nhập)
# CSP_EXTRA_IMG_HOSTS=images.unsplash.com,picsum.photos

# --------------------------------------------------------
# II. CỜ KIỂM SOÁT DỮ LIỆU DEMO & LOG (TÙY CHỌN)
# --------------------------------------------------------

# [TÙY CHỌN - Mặc định: false] Ở Production luôn đặt "false" để không bao giờ in link đặt lại mật khẩu ra log
ENABLE_DEMO_EMAIL_LOG="false"

# [TÙY CHỌN - Mặc định: false] Ở Production mặc định chỉ tạo danh mục gốc, chính sách, FAQ và cài đặt cửa hàng.
# Chỉ khi đặt "true" mới nạp thêm 46 sản phẩm mẫu (vẫn tuyệt đối không tạo tài khoản khách mẫu).
ENABLE_SEED_DEMO_DATA="false"

# --------------------------------------------------------
# III. LƯU TRỮ ẢNH SUPABASE STORAGE (BẮT BUỘC Ở PRODUCTION)
# --------------------------------------------------------

# [BẮT BUỘC Ở PRODUCTION] URL dự án Supabase và Service Role Key để upload/xóa ảnh trên server
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# [TÙY CHỌN] Tên bucket công khai (ảnh đại diện, sản phẩm, đánh giá) và bucket riêng tư (ảnh minh chứng đổi trả)
SUPABASE_PUBLIC_BUCKET="baity-media"
SUPABASE_RETURNS_BUCKET="baity-returns"

# --------------------------------------------------------
# IV. DỊCH VỤ EMAIL GIAO DỊCH (QUÊN MẬT KHẨU)
# --------------------------------------------------------

# [BẮT BUỘC Ở PRODUCTION] Nhà cung cấp gửi email ('log' | 'brevo' | 'resend')
# - 'log': chỉ dùng ở môi trường dev (in thông báo giả lập)
# - 'brevo': gửi email thật qua Brevo HTTPS API (cần BREVO_API_KEY và EMAIL_FROM đã xác minh Sender)
# - 'resend': gửi email thật qua Resend HTTPS API (cần RESEND_API_KEY và EMAIL_FROM thuộc miền đã xác minh DNS)
EMAIL_PROVIDER="log"
EMAIL_FROM=""
BREVO_API_KEY=""
RESEND_API_KEY=""

# --------------------------------------------------------
# V. TRÍ TUỆ NHÂN TẠO, THANH TOÁN & TÁC VỤ ĐỊNH KỲ
# --------------------------------------------------------

# [BẮT BUỘC CHO TÍNH NĂNG AI] Khóa API Google Gemini (Tìm kiếm bằng ảnh & Trợ lý tư vấn)
GEMINI_API_KEY="your-gemini-api-key-placeholder"
CHATBOT_MODEL="gemini-3-flash-preview"
VISUAL_SEARCH_MODEL="gemini-3-flash-preview"

# [TÙY CHỌN] Trần chi phí & giới hạn tốc độ Tìm kiếm bằng hình ảnh AI
VISUAL_SEARCH_DAILY_GLOBAL_CAP=300
VISUAL_SEARCH_DAILY_USER_CAP=15
VISUAL_SEARCH_BURST_PER_MIN_CAP=5
VISUAL_SEARCH_REFINE_PER_MIN_CAP=30

# [BẮT BUỘC Ở PRODUCTION] Khóa bí mật xác thực API dọn dẹp định kỳ POST /api/tasks/cron-cleanup (header x-cron-secret)
CRON_SECRET_KEY="replace-with-strong-cron-secret-key"

# [BẮT BUỘC Ở PRODUCTION] Khóa bí mật chính xác thực chữ ký HMAC-SHA256 cho Webhook thanh toán (POST /api/payments/webhook; hỗ trợ alias tương thích ngược WEBHOOK_SECRET)
PAYMENT_WEBHOOK_SECRET="replace-with-strong-payment-webhook-secret"
ENABLE_DEMO_PAYMENT_WEBHOOK="false"

# [TÙY CHỌN] Cấu hình tài khoản ngân hàng hiển thị mã QR chuyển khoản VietQR
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0987654321"
VIETQR_ACCOUNT_NAME="CONG TY THOI TRANG BAITY"

